{
  "name": "ligant-molarity-converter",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Molarity Converter for Biologics (C1) - deterministic, client-side mass/molar concentration conversion with compelled molecular-weight declarations",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "study:precision": "vite-node scripts/precision-study.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:privacy && npm run check:ui && npm run check:network && npm run check:reimplementation",
    "record:invariance": "vite-node scripts/record-invariance.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:network": "node scripts/check-network.mjs",
    "export:reference": "vite-node scripts/export-reference-set.ts",
    "check:reimplementation": "npm run export:reference && python3 reference/compare.py && python3 reference/exact.py",
    "check:ui": "node scripts/check-ui.mjs",
    "check:exact": "python3 reference/exact.py",
    "check:deployed": "node -e \"const s=require('fs').readFileSync('src/lib/site.ts','utf8');const u=s.match(/SITE_URL\\s*=\\s*.([^']+)./)[1]+s.match(/TOOL_PATH\\s*=\\s*.([^']+)./)[1];process.stdout.write(u)\" | xargs node scripts/check-network.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
